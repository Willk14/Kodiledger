# Application
PROJECT_NAME=KodiFlow Backend Engine

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kodiflow_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
SYSTEM_DATABASE_URL=postgresql+asyncpg://SYSTEM_USER:SYSTEM_PASSWORD@HOST:PORT/DB

# Dedicated disposable RLS integration-test PostgreSQL instance.
# Configure actual values only in the ignored local .env.rls-test file.
RLS_TEST_PORT=5435
RLS_TEST_POSTGRES_PASSWORD=CHANGE_ME
RLS_TEST_APP_PASSWORD=CHANGE_ME
RLS_TEST_SYSTEM_PASSWORD=CHANGE_ME
RLS_TEST_ADMIN_BOOTSTRAP_DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5435/kodiflow_db
RLS_TEST_ADMIN_DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5435/kodiflow_test
RLS_TEST_DATABASE_URL=postgresql+asyncpg://kodiflow_app:PASSWORD@127.0.0.1:5435/kodiflow_test
RLS_TEST_SYSTEM_DATABASE_URL=postgresql+asyncpg://kodiflow_system:PASSWORD@127.0.0.1:5435/kodiflow_test

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# M-Pesa Daraja
MPESA_CONSUMER_KEY=CHANGE_ME
MPESA_CONSUMER_SECRET=CHANGE_ME
MPESA_PASSKEY=CHANGE_ME
MPESA_SHORTCODE=CHANGE_ME
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_URL=CHANGE_ME
MPESA_CALLBACK_TOKEN=replace-with-a-random-callback-token-of-at-least-32-characters

# CORS
CORS_ALLOWED_ORIGINS=https://example.com

# Authentication (OIDC access-token validation)
# These are public provider settings. Configure them for the selected OIDC issuer.
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_AUDIENCE=kodiledger-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_SIGNING_ALGORITHMS=RS256
OIDC_JWKS_TIMEOUT_SECONDS=5

# Transactional outbox delivery
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_BATCH_WAIT_MS=1000
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_LOCK_TIMEOUT_SECONDS=300
